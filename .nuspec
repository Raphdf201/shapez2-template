<?xml version="1.0" encoding="utf-8"?>
<package>
    <metadata>
        <id>Raphdf201.Shapez2Template</id>
        <version>1.0.2</version>
        <authors>Raphdf201</authors>
        <description>A template for creating Shapez 2 mods</description>
        <readme>README.md</readme>
        <license type="file">LICENSE.txt</license>
        <repository type="git" url="https://github.com/Raphdf201/shapez2-template" />
        <packageTypes>
            <packageType name="Template" />
        </packageTypes>
    </metadata>
    <files>
        <file src="**" target="content" exclude="**\.git\**;**\.idea\**;**\logs\**;**\obj\**;**\*.user;**\*.nuspec" />
        <file src="README.md" target="" />
        <file src="LICENSE.txt" target="" />
    </files>
</package>
